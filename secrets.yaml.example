# Copy to secrets.yaml and replace every example before compiling for hardware.
ikettle_wifi_ssid: "YOUR_2_4_GHZ_NETWORK"
ikettle_wifi_password: "REPLACE_WITH_WIFI_PASSWORD"
ikettle_recovery_ap_ssid: "iKettle-Recovery"
ikettle_recovery_ap_password: "REPLACE_WITH_UNIQUE_RECOVERY_PASSWORD"
# python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ikettle_api_encryption_key: "REPLACE_WITH_GENERATED_BASE64_KEY"
